# ---- Database ----
DATABASE_URL="file:./dev.db"

# ---- App ----
# 予約システムの公開URL（リマインドメール内のリンク等に使用）
APP_URL="http://localhost:3000"
# 営業時間の基準タイムゾーン
TIMEZONE="Asia/Tokyo"

# ---- 管理画面の簡易認証 ----
# 管理画面・APIアクセス用トークン（本番では必ず変更）
ADMIN_TOKEN="change-me-admin-token"

# ---- リマインド用 Cron 認証 ----
# /api/cron/reminders を叩く際の Bearer トークン
CRON_SECRET="change-me-cron-secret"

# ---- メール送信 (nodemailer) ----
# MAIL_DRIVER=console の場合は実送信せずコンソール出力（開発デフォルト）
# MAIL_DRIVER=smtp の場合は下記 SMTP 設定を使用
MAIL_DRIVER="console"
MAIL_FROM="予約システム <noreply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ---- Google Calendar 連携 ----
# GOOGLE_CALENDAR_DRIVER=noop なら連携せずログのみ（デフォルト）
# GOOGLE_CALENDAR_DRIVER=google なら実連携（サービスアカウント設定が必要）
GOOGLE_CALENDAR_DRIVER="noop"
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
